{
  "mcpServers": {
    "opencode-observer": {
      "command": "node",
      "args": [
        "/ABSOLUTE/CLONE/PATH/tools/opencode-observer/index.mjs"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "ui-skills": {
      "type": "http",
      "url": "https://www.ui-skills.com/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
