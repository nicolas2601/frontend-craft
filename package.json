{
  "name": "frontend-craft",
  "version": "2.6.0",
  "private": true,
  "description": "Frontend skills for any coding agent: dealt art directions, scroll set pieces and real photographs for websites, a browser gate that fails flat pages, polish and motion skills",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:unit": "node --test tests/library.test.mjs tests/deal.test.mjs tests/rules.test.mjs tests/gate.test.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/verify.mjs && node --test \"tests/*.test.mjs\"",
    "pack": "node scripts/pack.mjs",
    "eval": "node scripts/eval.mjs",
    "observer:test": "npm --prefix tools/opencode-observer test",
    "test:blueprints": "node scripts/blueprints.mjs",
    "test:frameworks": "node scripts/frameworks.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
